[Unit]
Description=Studica VMX robot_manager (runs robotCommand as root)
After=network.target

[Service]
Type=simple
# root: the VMX HAL (pigpio) needs /dev/mem
User=root
# The supervisor and its journal/RioLog workers stay on normal scheduling.
# Robot Manager applies RT policy only to the robot child before exec.
CPUSchedulingPolicy=other
LimitRTPRIO=99
# System components stay on Core 4 (CPU index 3); the robot program owns CPU 0,1,2
CPUAffinity=3
ExecStart=/opt/robot_manager/robot_manager --config /etc/robot_manager/config.json
Restart=always
RestartSec=2
# stop the whole robot process tree, not only the main process
KillMode=control-group
TimeoutStopSec=15
# Aggressively swap idle supervisor/worker memory to zram
MemorySwapMax=infinity
MemoryHigh=64M

[Install]
WantedBy=multi-user.target
Alias=robot.service
