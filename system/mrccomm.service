[Unit]
Description=W4Studica MrcCommDaemon: FRC Driver Station communication protocol
After=network.target
Wants=robot.service

[Service]
Type=simple
ExecStart=/opt/robot_manager/robot_manager mrccomm --port 1110 --ds-port 1150
Restart=always
RestartSec=2
CPUSchedulingPolicy=other
# System components stay on Core 4 (CPU index 3); the robot program owns CPU 0,1,2
CPUAffinity=3
# Memory policy (RUNTIME_BASELINE.md, "Swap and memory policy"): every leaf
# system daemon has the same soft cap, so its idle pages live in zram.
MemorySwapMax=infinity
MemoryHigh=32M

[Install]
WantedBy=multi-user.target
