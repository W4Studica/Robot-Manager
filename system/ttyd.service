[Unit]
Description=W4Studica Web Terminal (ttyd on port 7681)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/ttyd -p 7681 -t fontSize=14 login
Restart=always
RestartSec=3
CPUSchedulingPolicy=idle
# System components stay on Core 4 (CPU index 3); the robot program owns CPU 0,1,2
CPUAffinity=3
# Memory policy (RUNTIME_BASELINE.md, "Swap and memory policy"): every leaf
# system daemon has the same soft cap, so its idle pages live in zram.
MemorySwapMax=infinity
MemoryHigh=32M

[Install]
WantedBy=multi-user.target
