[Unit]
Description=Studica VMX hardware monitor (CPU temperature, voltage throttling, RAM/zram)
After=network.target

[Service]
Type=simple
ExecStart=/opt/robot_manager/robot_manager hwmon --daemon --interval 5
Restart=always
RestartSec=5
CPUSchedulingPolicy=idle
# System components stay on Core 4 (CPU index 3); the robot program owns CPU 0,1,2
CPUAffinity=3
# Memory policy (RUNTIME_BASELINE.md, "Swap and memory policy"): every leaf
# system daemon has the same soft cap, so its idle pages live in zram.
MemorySwapMax=infinity
MemoryHigh=32M

[Install]
WantedBy=multi-user.target
